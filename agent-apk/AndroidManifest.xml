<?xml version="1.0" encoding="utf-8"?>
<!--
  droidrt device agent. There is no launcher activity and no network
  permission: the host talks to the agent over an abstract local socket
  that adb forwards, and every connection must authenticate with a key the
  host delivers through KeyReceiver (see README.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.droidrt.agent">

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <service
            android:name=".AgentService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".NotifyService"
            android:exported="true"
            android:label="@string/notify_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Receives the connection key from the host (see README.md). DUMP is
          held by the adb shell but cannot be granted to regular apps.
        -->
        <receiver
            android:name=".KeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.droidrt.agent.SET_KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
